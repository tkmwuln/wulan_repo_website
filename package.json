{
  "name": "website-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=lenusa",
    "dev:lenusa": "npm run dev --workspace=lenusa",
    "dev:nutrichat": "npm run dev --workspace=nutrichat",
    "build": "npm run build --workspaces --if-present",
    "build:lenusa": "npm run build --workspace=lenusa",
    "build:nutrichat": "npm run build --workspace=nutrichat"
  }
}
