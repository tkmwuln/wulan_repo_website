{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "NutriChat design tokens (W3C DTCG format). Mirrors the CSS variables in src/index.css (@theme). Keep both in sync.",
  "color": {
    "primary": {
      "50":  { "$type": "color", "$value": "#F5F2FF" },
      "100": { "$type": "color", "$value": "#ECE7FF" },
      "200": { "$type": "color", "$value": "#D9D1FF" },
      "300": { "$type": "color", "$value": "#C9BFFF" },
      "400": { "$type": "color", "$value": "#A99BFF" },
      "500": { "$type": "color", "$value": "#8B7BFF" },
      "600": { "$type": "color", "$value": "#6B5CE7" },
      "700": { "$type": "color", "$value": "#5B4EE0" },
      "800": { "$type": "color", "$value": "#4A3FC0" }
    },
    "accent": {
      "pink":   { "$type": "color", "$value": "#F3A6D8" },
      "blush":  { "$type": "color", "$value": "#FDEEF6" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#FAFAFA" },
      "100": { "$type": "color", "$value": "#F5F5F5" },
      "200": { "$type": "color", "$value": "#E5E5E5" },
      "400": { "$type": "color", "$value": "#A3A3A3" },
      "500": { "$type": "color", "$value": "#737373" },
      "700": { "$type": "color", "$value": "#404040" },
      "900": { "$type": "color", "$value": "#1B1B22" },
      "ink": { "$type": "color", "$value": "#141418" }
    },
    "surface": {
      "app":     { "$type": "color", "$value": "#F6EEF9", "$description": "App background mid stop" },
      "panel":   { "$type": "color", "$value": "#FFFFFF99", "$description": "Bento panel (white 60%)" },
      "card":    { "$type": "color", "$value": "#FFFFFF" },
      "subtle":  { "$type": "color", "$value": "#FAF9FE" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#10B981" },
      "warning": { "$type": "color", "$value": "#F59E0B" },
      "danger":  { "$type": "color", "$value": "#F43F5E" },
      "info":    { "$type": "color", "$value": "#0EA5E9" }
    },
    "nutrient": {
      "sugar":   { "$type": "color", "$value": "#A78BFA" },
      "salt":    { "$type": "color", "$value": "#FBBF24" },
      "fat":     { "$type": "color", "$value": "#F472B6" },
      "protein": { "$type": "color", "$value": "#38BDF8" }
    },
    "source": {
      "tkpi":  { "$type": "color", "$value": "#34D399", "$description": "TKPI Kemenkes" },
      "label": { "$type": "color", "$value": "#38BDF8", "$description": "Label gizi BPOM" },
      "ai":    { "$type": "color", "$value": "#FBBF24", "$description": "Estimasi AI" }
    },
    "nuri-mood": {
      "neutral": { "$type": "color", "$value": "#A9C4FF" },
      "calm":    { "$type": "color", "$value": "#6FD3A4" },
      "excited": { "$type": "color", "$value": "#FFAD4D" },
      "love":    { "$type": "color", "$value": "#FF8CC4" },
      "cold":    { "$type": "color", "$value": "#6FB4FF" },
      "sad":     { "$type": "color", "$value": "#9DA4B5" },
      "angry":   { "$type": "color", "$value": "#F0524A" }
    }
  },
  "gradient": {
    "primary": { "$type": "gradient", "$value": [{ "color": "#8B7BFF", "position": 0 }, { "color": "#B08CFF", "position": 1 }], "$description": "Primary CTA: Chat baru, Kirim, Upgrade" },
    "brand":   { "$type": "gradient", "$value": [{ "color": "#A99BFF", "position": 0 }, { "color": "#F3A6D8", "position": 1 }] }
  },
  "font": {
    "family": { "sans": { "$type": "fontFamily", "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] } },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    },
    "size": {
      "2xs": { "$type": "dimension", "$value": "10px" },
      "xs":  { "$type": "dimension", "$value": "12px" },
      "sm":  { "$type": "dimension", "$value": "14px" },
      "lg":  { "$type": "dimension", "$value": "18px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "36px" }
    }
  },
  "radius": {
    "sm":    { "$type": "dimension", "$value": "8px" },
    "md":    { "$type": "dimension", "$value": "12px" },
    "lg":    { "$type": "dimension", "$value": "16px" },
    "card":  { "$type": "dimension", "$value": "28px" },
    "control": { "$type": "dimension", "$value": "9999px", "$description": "Buttons, fields, chips" },
    "shell": { "$type": "dimension", "$value": "28px" },
    "full":  { "$type": "dimension", "$value": "9999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" }
  },
  "shadow": {
    "primary": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "6px", "blur": "16px", "spread": "-6px", "color": "#6B5CE773" } },
    "composer": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "10px", "blur": "40px", "spread": "-15px", "color": "#826EDC59" } },
    "popover": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "30px", "blur": "80px", "spread": "-20px", "color": "#5A46B459" } }
  },
  "component": {
    "button-primary": {
      "background": { "$type": "gradient", "$value": "{gradient.primary}" },
      "text":       { "$type": "color", "$value": "{color.neutral.0}" },
      "radius":     { "$type": "dimension", "$value": "{radius.control}" },
      "shadow":     { "$type": "shadow", "$value": "{shadow.primary}" }
    },
    "button-secondary": {
      "background": { "$type": "color", "$value": "{color.neutral.0}" },
      "border":     { "$type": "color", "$value": "{color.neutral.200}" },
      "text":       { "$type": "color", "$value": "{color.neutral.900}" }
    },
    "panel": {
      "background": { "$type": "color", "$value": "{color.surface.panel}" },
      "radius":     { "$type": "dimension", "$value": "{radius.card}" },
      "padding":    { "$type": "dimension", "$value": "{space.3}" }
    },
    "card": {
      "background": { "$type": "color", "$value": "{color.surface.card}" },
      "border":     { "$type": "color", "$value": "{color.neutral.100}" },
      "radius":     { "$type": "dimension", "$value": "{radius.card}" },
      "padding":    { "$type": "dimension", "$value": "{space.5}" }
    }
  }
}
